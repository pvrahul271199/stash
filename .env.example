# Copy to .env.local (untracked). Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google sign-in (public client ID only; never the client secret). Same value goes in Supabase -> Auth -> Providers -> Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1033835613848-msamv3pgkic48mlmemiavkb2agmbnbcm.apps.googleusercontent.com
# Your Vercel URL (must be an Authorized JavaScript origin in Google Cloud)
NEXT_PUBLIC_APP_URL=https://www.chelav.app

# PostHog product analytics (public browser configuration)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
