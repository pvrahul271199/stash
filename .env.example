# Supabase configuration for Stash Web App
# Copy this file to `.env.local` and fill in your values from:
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Secret workspace key to isolate and sync your personal data across devices
# (e.g. your iPhone Safari PWA + your Mac browser) without needing a login screen.
NEXT_PUBLIC_STASH_WORKSPACE_ID=rahul-personal
