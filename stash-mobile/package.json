{
  "name": "stash-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/fix-expo.cjs",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --tunnel ngrok --clear",
    "tunnel": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --tunnel ngrok --clear",
    "lan": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --lan --clear",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "latest",
    "@expo-google-fonts/figtree": "latest",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
